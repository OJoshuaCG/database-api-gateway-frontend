# Base URL de la API versionada del Database API Gateway (incluye /api/v1).
# El backend debe incluir este origen del frontend en CORS_ORIGINS (no admite "*"
# junto a credenciales). Ej. dev: http://localhost:8000/api/v1
#
# EN DESPLIEGUE ESTO VA RELATIVO: `/api/v1`. La SPA y la API tienen que compartir origen
# porque la cookie de CSRF es host-only y desde otro host el JS no puede leerla — toda
# escritura devolvería 403 `auth.csrf_missing`. Ver docs/dokploy.md §3.
#
# En desarrollo el valor absoluto funciona igual porque las cookies NO se aíslan por puerto:
# :5173 y :8000 comparten el frasco del host `localhost`. Esa es justamente la razón por la
# que este problema no aparece hasta desplegar.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# URL del health check de liveness (vive en la raíz, fuera de /api/v1, sin auth).
# Opcional: si el backend no expone CORS en /health, el badge de salud se degrada.
VITE_HEALTH_URL=http://localhost:8000/health

# Tamaño máximo de página (query param `size`) que el frontend solicita a la API.
# Debe coincidir con el `size` máximo que admite el backend: si se pide más, la
# API responde 422. Se usa al poblar selects con la lista completa. Opcional:
# si falta o es inválida, el código usa 50 como fallback.
VITE_MAX_PAGE_SIZE=50
